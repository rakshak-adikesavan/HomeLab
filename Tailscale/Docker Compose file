services:

  tailscale:

    container_name: tailscale
    image: tailscale/tailscale:latest

    volumes:

      - ./tun:/dev/net/tun
      - ./lib:/var/lib

    environment:

      - TS_AUTH_KEY=key
      - TS_STATE_DIR=/var/lib/tailscale
      - TS_ROUTES=192.168.0.0/24
      - TS_HOSTNAME=peacekeeper
      - restart=unless-stopped 

    network_mode: host
    privileged: true
